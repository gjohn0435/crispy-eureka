<section class="about-literary-ai-section">
  <div class="container page-width">
    {% if section.settings.heading != blank %}
      <div class="section-intro">
        <h2 class="section-heading text-center">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="profile-section">
      <div class="profile-container">
        {% if section.settings.image %}
          <div class="profile-image-wrapper">
            <div class="profile-image">
              {{
                section.settings.image
                | image_url: width: 600
                | image_tag:
                  loading: 'lazy',
                  width: section.settings.image.width,
                  height: section.settings.image.height,
                  alt: section.settings.image.alt | escape
              }}
            </div>
          </div>
        {% endif %}

        <div class="profile-content">
          {% if section.settings.profile_name != blank %}
            <h3 class="profile-name">{{ section.settings.profile_name }}</h3>
          {% endif %}

          {% if section.settings.profile_title != blank %}
            <p class="profile-title">{{ section.settings.profile_title }}</p>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="profile-description rte">
              {{ section.settings.description }}
            </div>
          {% endif %}

          {% if section.settings.show_cta %}
            <div class="profile-cta">
              <a href="{{ section.settings.cta_link }}" class="btn-primary">
                {{ section.settings.cta_text }}
              </a>
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="features-grid">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'feature' %}
              <div class="feature-item" {{ block.shopify_attributes }}>
                {% if block.settings.icon != blank %}
                  <div class="feature-icon">
                    <i class="{{ block.settings.icon }}"></i>
                  </div>
                {% endif %}
                <h3 class="feature-title">{{ block.settings.title }}</h3>
                <p class="feature-description">{{ block.settings.description }}</p>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
.about-literary-ai-section {
  padding: 5rem 0;
  background: linear-gradient(180deg, white 0%, var(--parchment-light, #E8E4DC) 100%);
}

.section-intro {
  text-align: center;
  margin-bottom: 3rem;
}

.section-heading {
  font-family: 'Baskerville', 'Georgia', serif;
  color: var(--magician-primary, #6B4C9A);
  font-size: 2.5rem;
  margin-bottom: 1rem;
  font-weight: 700;
  position: relative;
  display: inline-block;
}

.section-heading::after {
  content: '';
  position: absolute;
  bottom: -10px;
  left: 50%;
  transform: translateX(-50%);
  width: 80px;
  height: 4px;
  background: var(--wisdom-gradient, linear-gradient(45deg, #4A5D23 0%, #B8860B 100%));
  border-radius: 2px;
}

.text-center {
  text-align: center;
}

.profile-section {
  margin-bottom: 4rem;
}

.profile-container {
  display: grid;
  grid-template-columns: 400px 1fr;
  gap: 4rem;
  align-items: start;
  background: white;
  padding: 3rem;
  border-radius: 16px;
  box-shadow: 0 8px 32px rgba(107, 76, 154, 0.12);
  border: 2px solid transparent;
  transition: all 0.3s ease;
}

.profile-container:hover {
  border-color: var(--magician-light, #9370DB);
  box-shadow: 0 12px 40px rgba(107, 76, 154, 0.18);
}

.profile-image-wrapper {
  position: relative;
}

.profile-image-wrapper::before {
  content: '';
  position: absolute;
  top: -15px;
  left: -15px;
  right: 15px;
  bottom: 15px;
  background: var(--mystical-gradient, linear-gradient(135deg, #7A9B76 0%, #6B4C9A 100%));
  border-radius: 12px;
  z-index: 0;
  opacity: 0.2;
}

.profile-image {
  position: relative;
  z-index: 1;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
}

.profile-image img {
  width: 100%;
  height: auto;
  display: block;
}

.profile-content {
  padding: 1rem 0;
}

.profile-name {
  font-family: 'Baskerville', 'Georgia', serif;
  color: var(--magician-primary, #6B4C9A);
  font-size: 2rem;
  margin-bottom: 0.5rem;
  font-weight: 700;
}

.profile-title {
  font-size: 1.125rem;
  color: var(--sage-deep, #4A5D23);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 1.5rem;
  opacity: 0.9;
}

.profile-description {
  font-size: 1.0625rem;
  line-height: 1.9;
  color: var(--text-primary, #1a1a1a);
  margin-bottom: 2rem;
}

.profile-description p {
  margin-bottom: 1rem;
}

.profile-description p:last-child {
  margin-bottom: 0;
}

.profile-cta {
  margin-top: 2rem;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2rem;
  margin-top: 3rem;
}

.feature-item {
  text-align: center;
  padding: 2rem;
  background: var(--parchment-light, #E8E4DC);
  border-radius: 12px;
  transition: all 0.3s ease;
}

.feature-item:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 24px rgba(107, 76, 154, 0.15);
}

.feature-icon {
  font-size: 2.5rem;
  color: var(--magician-gold, #B8860B);
  margin-bottom: 1rem;
}

.feature-title {
  font-family: 'Baskerville', 'Georgia', serif;
  color: var(--sage-deep, #4A5D23);
  font-size: 1.25rem;
  margin-bottom: 0.75rem;
}

.feature-description {
  color: var(--text-primary, #1a1a1a);
  line-height: 1.6;
}

@media screen and (max-width: 990px) {
  .profile-container {
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 2rem;
  }

  .profile-image-wrapper {
    max-width: 400px;
    margin: 0 auto;
  }

  .profile-content {
    text-align: center;
  }
}

@media screen and (max-width: 749px) {
  .about-literary-ai-section {
    padding: 3rem 0;
  }

  .section-heading {
    font-size: 2rem;
  }

  .profile-name {
    font-size: 1.75rem;
  }

  .profile-title {
    font-size: 1rem;
  }

  .features-grid {
    grid-template-columns: 1fr;
  }
}
</style>

{% schema %}
{
  "name": "About Literary AI",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "About Our Literary AI Platform"
    },
    {
      "type": "header",
      "content": "Profile Information"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Profile Image",
      "info": "Recommended size: 600x600px or larger"
    },
    {
      "type": "text",
      "id": "profile_name",
      "label": "Name",
      "default": "Dr. Literary Expert"
    },
    {
      "type": "text",
      "id": "profile_title",
      "label": "Title/Role",
      "default": "Chief Literary Analyst"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Biography/Description",
      "default": "<p>With over 15 years of experience in literary analysis and artificial intelligence, our team combines deep scholarly knowledge with cutting-edge technology. We've analyzed thousands of narratives, helping readers, writers, and researchers unlock deeper understanding of their favorite stories.</p><p>Our AI-powered platform represents the convergence of traditional literary scholarship and modern machine learning, creating tools that illuminate the hidden patterns within narratives.</p>"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show Call to Action Button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Learn More About Our Approach"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Font Awesome Icon Class",
          "default": "fas fa-brain",
          "info": "e.g., 'fas fa-brain', 'fas fa-book', 'fas fa-chart-line'"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "AI-Powered Analysis"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Feature Description",
          "default": "Advanced machine learning algorithms analyze narrative structure, character development, and thematic elements."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Literary AI",
      "settings": {
        "heading": "Meet Our Literary AI Expert",
        "profile_name": "Dr. Sarah Mitchell",
        "profile_title": "Chief Literary Analyst & AI Researcher",
        "description": "<p>With over 15 years of experience in literary analysis and artificial intelligence, Dr. Mitchell leads our team in combining deep scholarly knowledge with cutting-edge technology. She has analyzed thousands of narratives, helping readers, writers, and researchers unlock deeper understanding of their favorite stories.</p><p>Her groundbreaking work in computational narratology has been published in leading academic journals, and she regularly speaks at international conferences on the intersection of AI and literary studies.</p>",
        "show_cta": true,
        "cta_text": "Learn More About Our Approach",
        "cta_link": ""
      },
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "fas fa-brain",
            "title": "AI-Powered Analysis",
            "description": "Advanced machine learning algorithms analyze narrative structure, character development, and thematic elements."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "fas fa-graduation-cap",
            "title": "Scholarly Accuracy",
            "description": "Built on literary theory and research methodologies trusted by academics and professionals."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "fas fa-users",
            "title": "Community Driven",
            "description": "Join thousands of readers, writers, and scholars using our platform to deepen their understanding."
          }
        }
      ]
    }
  ]
}
{% endschema %}
