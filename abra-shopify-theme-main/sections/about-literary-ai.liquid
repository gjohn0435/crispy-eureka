<section class="about-literary-ai-section">
  <div class="container page-width">
    <div class="about-grid">
      <div class="about-content">
        {% if section.settings.heading != blank %}
          <h2 class="about-heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="about-description rte">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.show_cta %}
          <a href="{{ section.settings.cta_link }}" class="btn-primary">
            {{ section.settings.cta_text }}
          </a>
        {% endif %}
      </div>

      {% if section.settings.image %}
        <div class="about-image">
          {{
            section.settings.image
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              width: section.settings.image.width,
              height: section.settings.image.height,
              alt: section.settings.image.alt | escape
          }}
        </div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="features-grid">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'feature' %}
              <div class="feature-item" {{ block.shopify_attributes }}>
                {% if block.settings.icon != blank %}
                  <div class="feature-icon">
                    <i class="{{ block.settings.icon }}"></i>
                  </div>
                {% endif %}
                <h3 class="feature-title">{{ block.settings.title }}</h3>
                <p class="feature-description">{{ block.settings.description }}</p>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
.about-literary-ai-section {
  padding: 5rem 0;
  background: white;
}

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
  margin-bottom: 4rem;
}

.about-heading {
  font-family: 'Baskerville', 'Georgia', serif;
  color: var(--magician-primary, #6B4C9A);
  font-size: 2.5rem;
  margin-bottom: 1.5rem;
}

.about-description {
  font-size: 1.125rem;
  line-height: 1.8;
  color: var(--text-secondary, #5A5A5A);
  margin-bottom: 2rem;
}

.about-description p {
  margin-bottom: 1rem;
}

.about-image {
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(107, 76, 154, 0.15);
}

.about-image img {
  width: 100%;
  height: auto;
  display: block;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2rem;
  margin-top: 3rem;
}

.feature-item {
  text-align: center;
  padding: 2rem;
  background: var(--parchment-light, #E8E4DC);
  border-radius: 12px;
  transition: all 0.3s ease;
}

.feature-item:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 24px rgba(107, 76, 154, 0.15);
}

.feature-icon {
  font-size: 2.5rem;
  color: var(--magician-gold, #B8860B);
  margin-bottom: 1rem;
}

.feature-title {
  font-family: 'Baskerville', 'Georgia', serif;
  color: var(--sage-deep, #4A5D23);
  font-size: 1.25rem;
  margin-bottom: 0.75rem;
}

.feature-description {
  color: var(--text-secondary, #5A5A5A);
  line-height: 1.6;
}

@media screen and (max-width: 749px) {
  .about-literary-ai-section {
    padding: 3rem 0;
  }

  .about-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .about-heading {
    font-size: 2rem;
  }

  .features-grid {
    grid-template-columns: 1fr;
  }
}
</style>

{% schema %}
{
  "name": "About Literary AI",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "About Our Literary AI Platform"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>We harness the power of artificial intelligence to unlock deeper understanding of literature. Our platform combines scholarly wisdom with cutting-edge technology to transform how readers, writers, and researchers engage with narratives.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Featured Image"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show Call to Action Button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Explore Our Platform"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Font Awesome Icon Class",
          "default": "fas fa-brain",
          "info": "e.g., 'fas fa-brain', 'fas fa-book', 'fas fa-chart-line'"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "AI-Powered Analysis"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Feature Description",
          "default": "Advanced machine learning algorithms analyze narrative structure, character development, and thematic elements."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Literary AI",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "fas fa-brain",
            "title": "AI-Powered Analysis",
            "description": "Advanced machine learning algorithms analyze narrative structure, character development, and thematic elements."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "fas fa-graduation-cap",
            "title": "Scholarly Accuracy",
            "description": "Built on literary theory and research methodologies trusted by academics and professionals."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "fas fa-users",
            "title": "Community Driven",
            "description": "Join thousands of readers, writers, and scholars using our platform to deepen their understanding."
          }
        }
      ]
    }
  ]
}
{% endschema %}
