<section class="newsletter-section">
  <div class="newsletter-container page-width">
    <div class="newsletter-content">
      {% if section.settings.icon != blank %}
        <div class="newsletter-icon">
          <i class="{{ section.settings.icon }}"></i>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="newsletter-heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="newsletter-subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="newsletter-description rte">
          {{ section.settings.description }}
        </div>
      {% endif %}

      <div class="newsletter-form-wrapper">
        {% form 'customer', class: 'newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {% if form.posted_successfully? %}
            <div class="newsletter-success">
              <i class="fas fa-check-circle"></i>
              <p>{{ section.settings.success_message }}</p>
            </div>
          {% else %}
            <div class="newsletter-input-group">
              <input
                type="email"
                name="contact[email]"
                id="NewsletterEmail-{{ section.id }}"
                placeholder="{{ section.settings.email_placeholder }}"
                required
                class="newsletter-email-input"
                aria-label="Email address"
              >
              <button type="submit" class="newsletter-submit btn-primary">
                {{ section.settings.button_text }}
              </button>
            </div>

            {% if form.errors %}
              <div class="newsletter-error">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}
          {% endif %}
        {% endform %}

        {% if section.settings.show_privacy_note %}
          <p class="newsletter-privacy">
            {{ section.settings.privacy_note }}
          </p>
        {% endif %}
      </div>

      {% if section.blocks.size > 0 %}
        <div class="newsletter-benefits">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'benefit' %}
                <div class="benefit-item" {{ block.shopify_attributes }}>
                  {% if block.settings.icon != blank %}
                    <i class="{{ block.settings.icon }}"></i>
                  {% endif %}
                  <span>{{ block.settings.text }}</span>
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
.newsletter-section {
  padding: 5rem 0;
  background: linear-gradient(135deg, var(--sage-primary, #7A9B76) 0%, var(--magician-primary, #6B4C9A) 100%);
  color: white;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.newsletter-section::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
  pointer-events: none;
}

.newsletter-container {
  position: relative;
  z-index: 1;
}

.newsletter-content {
  max-width: 700px;
  margin: 0 auto;
}

.newsletter-icon {
  font-size: 3rem;
  color: var(--magician-gold, #B8860B);
  margin-bottom: 1.5rem;
}

.newsletter-heading {
  font-family: 'Baskerville', 'Georgia', serif;
  font-size: 2.5rem;
  margin-bottom: 1rem;
  color: white;
}

.newsletter-subheading {
  font-size: 1.25rem;
  margin-bottom: 1rem;
  opacity: 0.95;
}

.newsletter-description {
  font-size: 1rem;
  line-height: 1.7;
  margin-bottom: 2rem;
  opacity: 0.9;
}

.newsletter-form-wrapper {
  margin-top: 2rem;
}

.newsletter-input-group {
  display: flex;
  gap: 0.5rem;
  max-width: 500px;
  margin: 0 auto;
}

.newsletter-email-input {
  flex: 1;
  padding: 1rem 1.5rem;
  border: none;
  border-radius: 6px;
  font-size: 1rem;
  background: white;
  color: var(--text-primary, #2C2C2C);
}

.newsletter-email-input::placeholder {
  color: rgba(44, 44, 44, 0.5);
}

.newsletter-email-input:focus {
  outline: 2px solid var(--magician-gold, #B8860B);
  outline-offset: 2px;
}

.newsletter-submit {
  padding: 1rem 2rem;
  white-space: nowrap;
  background: var(--magician-gold, #B8860B);
  border: none;
}

.newsletter-submit:hover {
  background: var(--sage-deep, #4A5D23);
}

.newsletter-success {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  padding: 1.5rem;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8px;
  font-size: 1.125rem;
}

.newsletter-success i {
  font-size: 1.5rem;
  color: var(--magician-gold, #B8860B);
}

.newsletter-error {
  margin-top: 1rem;
  padding: 1rem;
  background: rgba(220, 53, 69, 0.2);
  border-radius: 6px;
  color: white;
}

.newsletter-privacy {
  margin-top: 1rem;
  font-size: 0.875rem;
  opacity: 0.8;
}

.newsletter-benefits {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 2rem;
  margin-top: 2rem;
}

.benefit-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.95rem;
}

.benefit-item i {
  color: var(--magician-gold, #B8860B);
}

@media screen and (max-width: 749px) {
  .newsletter-section {
    padding: 3rem 0;
  }

  .newsletter-heading {
    font-size: 2rem;
  }

  .newsletter-input-group {
    flex-direction: column;
  }

  .newsletter-submit {
    width: 100%;
  }

  .newsletter-benefits {
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
}
</style>

{% schema %}
{
  "name": "Newsletter Signup",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "icon",
      "label": "Icon Class",
      "default": "fas fa-envelope",
      "info": "Font Awesome icon class (e.g., 'fas fa-envelope', 'fas fa-paper-plane')"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join Our Literary Community"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Stay Updated with Literary Insights"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Get exclusive access to literary analysis insights, new features, and special offers delivered to your inbox.</p>"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email Input Placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Thanks for subscribing! Check your inbox for confirmation."
    },
    {
      "type": "checkbox",
      "id": "show_privacy_note",
      "label": "Show Privacy Note",
      "default": true
    },
    {
      "type": "text",
      "id": "privacy_note",
      "label": "Privacy Note",
      "default": "We respect your privacy. Unsubscribe at any time."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon Class",
          "default": "fas fa-check",
          "info": "Font Awesome icon class"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Benefit Text",
          "default": "Weekly literary insights"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Newsletter Signup",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "fas fa-book-open",
            "text": "Weekly literary insights"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "fas fa-gift",
            "text": "Exclusive offers & early access"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "fas fa-bell",
            "text": "New feature announcements"
          }
        }
      ]
    }
  ]
}
{% endschema %}
